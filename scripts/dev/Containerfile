FROM chimeralinux/chimera:latest@sha256:b58ec2b8c80561ba8f41d8852463585d22299b38737ce36d7d926cabf9c94174

RUN apk update && \
    apk add clang \
            llvm \
            ninja \
            muon \
            lld \
            musl-devel \
            libarchive-progs \
            wget2

# get raylib dep
RUN wget2 https://github.com/ruzen42/enet6-flake/releases/download/1.3.18/raylib-amd64-static.tar && \
    tar xvf raylib-amd64-static.tar && \
    mkdir -p /usr/lib /usr/include && \
    cp -r result/* /usr/ && \
    rm -rf result raylib-amd64-static.tar 

# get libiron dep
RUN wget2 https://github.com/ruzen42/iron-log/releases/download/2.1/linux-amd64-static.tar && \
    tar xvf linux-amd64-static.tar && \
    cp -r result/* /usr/ && \
    rm -rf result linux-amd64-static.tar

# get enet6 dep
RUN wget2 https://github.com/ruzen42/enet6-flake/releases/download/1.3.18/linux-amd64-static.tar && \
    tar xvf linux-amd64-static.tar && \
    cp -r result/* /usr/ && \
    rm -rf result linux-amd64-static.tar

WORKDIR /work
